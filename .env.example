NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Yalnız sunucu tarafındaki superadmin katalog görsel üretimi için.
# Tarayıcıya/NEXT_PUBLIC değişkenlerine koymayın.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Satıcının "ek mahalle ekle" checkout'u için İyzico Checkout Form kimlik bilgileri.
# Sandbox: https://sandbox-merchant.iyzipay.com panelinden alınır, IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlı: IYZICO_BASE_URL=https://api.iyzipay.com
# Tanımlı değilse /api/seller/neighborhoods/checkout net bir "yapılandırılmadı" hatası döner.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Müşteri sepeti telefon OTP'si için NetGSM (Supabase'in yerleşik sağlayıcı listesinde
# yok, bu yüzden özel bir "Send SMS Hook" ile /api/auth/sms-hook üzerinden gönderiliyor).
# usercode: Netgsm abone numarası. password: "API Kullanıcısı" türünde alt kullanıcı
# şifresi (Ayarlar → Alt Kullanıcı). msgheader: onaylı gönderici adı (3-11 karakter).
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Supabase config.toml'daki [auth.hook.send_sms].secrets ile birebir aynı değer olmalı
# (format: v1,whsec_<base64>). supabase config push da bu değişkeni okur.
SEND_SMS_HOOK_SECRET=
